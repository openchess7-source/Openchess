# Path to the SQLite database file. On Render, this MUST point inside a
# mounted persistent disk (e.g. /var/data/openchess.db) — otherwise the
# database is wiped on every deploy and every restart. See server/README.md.
DATABASE_PATH=./data/openchess.db

# Long random string — used to sign auth cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The deployed frontend origin (no trailing slash). Needed for CORS + cookie SameSite.
FRONTEND_URL=https://your-frontend.vercel.app

NODE_ENV=production
PORT=4000
